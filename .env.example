# Copy this file to .env and fill in the token. .env is ignored by git.
# Fine-grained PAT with "Issues: read and write" on the test repository only.
GITHUB_TOKEN=

API_BASE_URL=https://api.github.com
API_VERSION=2026-03-10
OWNER=lucasgabrieldls
REPO=sqe3-issues-test
PUBLIC_OWNER=octocat
PUBLIC_REPO=Hello-World
MAX_RESPONSE_TIME_MS=2000
REQUEST_TIMEOUT=30
# Logging: minimum level shown in the console and written to the log file (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Folder where each run writes its log file (ignored by git)
LOG_DIRECTORY=logs

 
# Repositories tests: private repository of OWNER used by the read-only GET tests
READ_REPO=
# Repositories tests: classic token with the repo scope only
TOKEN_REPO_ONLY=
# Repositories tests: fine-grained token without Administration
TOKEN_NO_ADMIN=
# Repositories tests: seconds to wait after a test that creates repositories (GitHub limits content creation)
REPO_PAUSE_SECONDS=2
